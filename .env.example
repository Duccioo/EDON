HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# Set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
# Optional static token for external agents (Bearer). Tokens can also be created in Settings.
EDON_AGENT_TOKEN=
# Hermes (OpenAI-compatible API server, default http://127.0.0.1:8642). Can also be set in Settings.
HERMES_URL=
HERMES_API_KEY=
HERMES_MODEL=
# Optional local Obsidian vault directory. Can also be configured in Settings -> Integrazioni.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_FOLDER=
OBSIDIAN_ARCHIVE_FOLDER=
